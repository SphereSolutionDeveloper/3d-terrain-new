// ─── native-assets/shaders/terrain/magadi_terrain.comp ────────────────────────────
// Vulkan 1.3 GLSL Compute Shader - Procedural Contour Heightfield Generator
// Reference: Sascha Willems Vulkan Infinite Procedural Terrain (SaschaWillems/Vulkan)
#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, r32f) uniform writeonly image2D outHeightmap;

layout (push_constant) uniform ComputePushConstants {
    vec2 chunkOrigin;
    float chunkSizeM;
    float contourInterval;
    float stepTerracingFactor;
    uint resolution;
} pushConstants;

// Simplex/gradient noise pseudo-hash
float hash2D(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash2D(i + vec2(0.0, 0.0)), hash2D(i + vec2(1.0, 0.0)), u.x),
               mix(hash2D(i + vec2(0.0, 1.0)), hash2D(i + vec2(1.0, 1.0)), u.x), u.y);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= pushConstants.resolution || pixelCoord.y >= pushConstants.resolution) {
        return;
    }

    vec2 uv = vec2(pixelCoord) / float(pushConstants.resolution - 1);
    vec2 worldPos = pushConstants.chunkOrigin + uv * pushConstants.chunkSizeM;

    // Regional gradient: 590m to 1980m
    float u = clamp((worldPos.x + worldPos.y * 0.95) / 95000.0, 0.0, 1.0);
    float elev = 590.0 + u * 1390.0;

    // Fault scarps
    elev += sin(worldPos.x * 0.00035 + 0.8) * 65.0;
    elev += noise2D(worldPos * 0.0002) * 45.0;

    // Lake Magadi depression
    if (worldPos.x < 11000.0 && worldPos.y < 11000.0) {
        float lDist = length(worldPos);
        if (lDist < 9500.0) {
            float t = min(1.0, lDist / 9500.0);
            elev = 590.0 + (elev - 590.0) * (t * t);
        }
    }

    // Contour terracing
    if (pushConstants.stepTerracingFactor > 0.001) {
        float stepH = pushConstants.contourInterval;
        float baseStep = floor(elev / stepH) * stepH;
        float frac = (elev - baseStep) / stepH;
        float stepped = frac * frac * (3.0 - 2.0 * frac);
        elev = mix(elev, baseStep + stepped * stepH, pushConstants.stepTerracingFactor);
    }

    imageStore(outHeightmap, pixelCoord, vec4(elev, 0.0, 0.0, 0.0));
}
