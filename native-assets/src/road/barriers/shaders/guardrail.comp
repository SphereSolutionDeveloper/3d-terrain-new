// ==============================================================================
// Corrugated Galvanized W-Beam Guardrail Spangle & Specular Texture Kernel (.comp)
// Path: src/road/barriers/shaders/guardrail.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outGuardrailAlbedo;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outGuardrailNormalMetal;

layout(push_constant) uniform GuardrailPC {
    uint texSize;
    float spangleScale;
    float rustLevel;
    float beamCorrugationDepth;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    vec2 spangleCell;
    float spangleDist = roadVoronoiEdgeDist(uv * max(pc.spangleScale, 40.0), spangleCell);
    float zincFacet = 0.68 + 0.22 * roadHash21(spangleCell);

    // W-beam dual-wave vertical corrugation + splice bolt holes
    float waveProfile = sin(uv.y * ROAD_PI * 4.0);
    float dWaveDy = cos(uv.y * ROAD_PI * 4.0) * clamp(pc.beamCorrugationDepth, 0.2, 1.5);
    float boltPattern = 1.0 - smoothstep(0.015, 0.032, length(vec2(fract(uv.x * 2.0) - 0.5, abs(uv.y - 0.5) - 0.22)));

    float rust = smoothstep(0.58, 0.85, roadFbm(uv * 10.0) + clamp(pc.rustLevel, 0.0, 1.0) * 0.35) * clamp(pc.rustLevel, 0.0, 1.0);
    vec3 zincColor = vec3(zincFacet * 0.92, zincFacet * 0.94, zincFacet * 0.96) * (0.92 + 0.08 * waveProfile);
    zincColor = mix(zincColor, vec3(0.45, 0.21, 0.10), rust);
    zincColor *= (1.0 - boltPattern * 0.45);

    vec3 normalTS = normalize(vec3(0.0, -dWaveDy * 0.55, 1.0));
    float metallic = mix(0.88, 0.25, rust);

    imageStore(outGuardrailAlbedo, px, vec4(zincColor, 1.0));
    imageStore(outGuardrailNormalMetal, px, vec4(normalTS * 0.5 + 0.5, metallic));
}
