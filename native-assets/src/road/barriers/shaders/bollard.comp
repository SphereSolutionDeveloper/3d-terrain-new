// ==============================================================================
// ASTM F2656 Crash Bollard Brushed Steel & Retroreflective Collar Kernel (.comp)
// Path: src/road/barriers/shaders/bollard.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outBollardAlbedo;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outBollardMaterial;

layout(push_constant) uniform BollardPC {
    uint texSize;
    uint isSafetyYellow;
    float reflectiveBandHeight;
    float metallicFinish;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float brushStreak = roadValueNoise(vec2(uv.x * 16.0, uv.y * 160.0));

    vec3 bodyColor = (pc.isSafetyYellow != 0u)
        ? vec3(0.96, 0.72, 0.06) * (0.94 + 0.06 * brushStreak)
        : vec3(0.78, 0.81, 0.85) * (0.90 + 0.12 * brushStreak);

    // High-visibility retroreflective band near cap (uv.y in [0.74, 0.88])
    float bandHalf = clamp(pc.reflectiveBandHeight, 0.04, 0.14);
    float bandMask = 1.0 - smoothstep(bandHalf - 0.01, bandHalf + 0.01, abs(uv.y - 0.80));
    float stripeGrid = step(0.5, fract((uv.x + uv.y * 0.5) * 14.0));
    vec3 collarColor = mix(vec3(0.94, 0.96, 0.98), vec3(0.92, 0.14, 0.12), stripeGrid * 0.85);

    vec3 albedo = mix(bodyColor, collarColor, bandMask);
    float roughness = mix(mix(0.28, 0.42, pc.isSafetyYellow != 0u ? 1.0 : 0.0), 0.16, bandMask);
    float metallic = mix(clamp(pc.metallicFinish, 0.15, 0.95), 0.10, bandMask);
    float retroIntensity = bandMask * 0.95;

    imageStore(outBollardAlbedo, px, vec4(albedo, 1.0));
    imageStore(outBollardMaterial, px, vec4(roughness, metallic, retroIntensity, 1.0));
}
