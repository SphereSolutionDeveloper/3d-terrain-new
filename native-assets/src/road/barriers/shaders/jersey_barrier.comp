// ==============================================================================
// MASH F-Shape Precast Concrete Jersey Barrier Profile & Weathering Kernel (.comp)
// Path: src/road/barriers/shaders/jersey_barrier.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outBarrierAlbedo;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outBarrierNormalRough;

layout(push_constant) uniform JerseyBarrierPC {
    uint texSize;
    float weatheringIntensity;
    float reflectorSpacing;
    float scrapeIntensity;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float formGrain = roadFbm(uv * vec2(18.0, 32.0));

    // Precast concrete panel joint seam & road spray grime along base (uv.y < 0.25)
    float seamMask = 1.0 - smoothstep(0.0, 0.018, abs(fract(uv.x * 4.0) - 0.5));
    float grimeBand = (1.0 - smoothstep(0.0, 0.28, uv.y)) * clamp(pc.weatheringIntensity, 0.0, 1.0);
    float tireScrape = exp(-pow((uv.y - 0.34) * 14.0, 2.0)) * roadValueNoise(uv * vec2(32.0, 6.0)) * clamp(pc.scrapeIntensity, 0.0, 1.0);

    vec3 concrete = mix(vec3(0.68, 0.69, 0.67), vec3(0.76, 0.77, 0.75), formGrain);
    concrete = mix(concrete, vec3(0.34, 0.33, 0.30), grimeBand * 0.65);
    concrete = mix(concrete, vec3(0.14, 0.14, 0.15), tireScrape * 0.72);
    concrete *= (1.0 - seamMask * 0.45);

    // Amber delineator marker tabs along top flange
    float markerCell = abs(fract(uv.x * max(pc.reflectorSpacing, 2.0)) - 0.5);
    float markerMask = (1.0 - smoothstep(0.03, 0.05, markerCell)) * smoothstep(0.86, 0.90, uv.y);
    concrete = mix(concrete, vec3(1.0, 0.76, 0.08), markerMask);

    vec3 normalTS = normalize(vec3(seamMask * 0.3, (formGrain - 0.5) * 0.2, 1.0));
    float roughness = mix(0.86, 0.22, markerMask);

    imageStore(outBarrierAlbedo, px, vec4(concrete, 1.0));
    imageStore(outBarrierNormalRough, px, vec4(normalTS * 0.5 + 0.5, roughness));
}
