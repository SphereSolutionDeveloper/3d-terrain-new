// ==============================================================================
// Interchange Directional Gore Chevron & Diverging-Lane Texture Kernel (.comp)
// Path: src/road/interchanges/shaders/interchange_gore_tex.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outGoreAlbedo;
layout(set = 0, binding = 1, r8) uniform writeonly image2D outGoreRetroMask;

layout(push_constant) uniform InterchangeGorePC {
    uint texSize;
    float chevronAngleDeg;
    float chevronPeriod;
    float rubberSkidWear;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float slope = tan(radians(clamp(pc.chevronAngleDeg, 20.0, 65.0)));

    // V-shaped highway exit gore bounding lines + diagonal hatch chevrons
    float halfSpread = 0.06 + uv.y * 0.42;
    float edgeLine = min(abs((uv.x - 0.5) - halfSpread), abs((uv.x - 0.5) + halfSpread));
    float borderMask = 1.0 - smoothstep(0.014, 0.022, edgeLine);

    float insideGore = 1.0 - smoothstep(halfSpread - 0.02, halfSpread, abs(uv.x - 0.5));
    float hatchCoord = uv.y * max(pc.chevronPeriod, 6.0) - abs(uv.x - 0.5) * slope * 8.0;
    float hatchMask = insideGore * step(fract(hatchCoord), 0.34);

    float paintMask = clamp(max(borderMask, hatchMask), 0.0, 1.0);
    float skid = smoothstep(0.55, 0.85, roadFbm(uv * vec2(12.0, 4.0))) * clamp(pc.rubberSkidWear, 0.0, 1.0);

    vec3 asphalt = vec3(0.14, 0.15, 0.17) + roadFbm(uv * 28.0) * 0.04;
    vec3 paint = vec3(0.95, 0.96, 0.94) * (1.0 - skid * 0.42);
    vec3 finalColor = mix(asphalt, paint, paintMask);

    imageStore(outGoreAlbedo, px, vec4(finalColor, 1.0));
    imageStore(outGoreRetroMask, px, vec4(paintMask * (1.0 - skid * 0.3), 0.0, 0.0, 1.0));
}
