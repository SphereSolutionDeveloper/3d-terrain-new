// ==============================================================================
// Bridge Structural Steel, Rivet Seam & Helical Stay-Cable Texture Kernel (.comp)
// Path: src/road/bridges/shaders/bridge_steel_tex.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outSteelAlbedo;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outSteelNormalRough;

layout(push_constant) uniform BridgeSteelPC {
    uint texSize;
    float rivetFrequency;
    float patinaFactor;
    float brushedAnisotropy;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float brush = roadValueNoise(vec2(uv.x * 12.0, uv.y * max(pc.brushedAnisotropy, 96.0)));
    float weldSeam = 1.0 - smoothstep(0.0, 0.015, abs(fract(uv.x * 2.0) - 0.5));

    // Gusset plate rivet array along splice borders
    vec2 rUv = fract(uv * max(pc.rivetFrequency, 12.0)) - 0.5;
    float rivetDist = length(rUv);
    float nearSeam = 1.0 - smoothstep(0.06, 0.14, abs(fract(uv.x * 2.0) - 0.5));
    float rivetDome = (1.0 - smoothstep(0.14, 0.22, rivetDist)) * nearSeam;

    float oxide = smoothstep(0.55, 0.85, roadFbm(uv * 9.0)) * clamp(pc.patinaFactor, 0.0, 1.0);
    vec3 coatColor = mix(vec3(0.58, 0.62, 0.68), vec3(0.38, 0.20, 0.12), oxide);
    coatColor *= (0.90 + 0.14 * brush);
    coatColor += vec3(0.08) * rivetDome - vec3(0.12) * weldSeam;

    vec3 normalTS = normalize(vec3(rUv.x * rivetDome * 2.5, rUv.y * rivetDome * 2.5, 1.0));
    float roughness = clamp(mix(0.32, 0.78, oxide) + weldSeam * 0.25, 0.18, 0.92);

    imageStore(outSteelAlbedo, px, vec4(coatColor, 1.0));
    imageStore(outSteelNormalRough, px, vec4(normalTS * 0.5 + 0.5, roughness));
}
