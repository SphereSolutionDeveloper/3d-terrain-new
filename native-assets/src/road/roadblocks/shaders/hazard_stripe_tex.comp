// ==============================================================================
// MUTCD Workzone Safety Barricade Chevron & Type IV Sheeting Kernel (.comp)
// Path: src/road/roadblocks/shaders/hazard_stripe_tex.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outHazardAlbedo;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outHazardMaterial;

layout(push_constant) uniform HazardStripePC {
    uint texSize;
    uint isRedWhiteStop; // 0 = Orange/White Workzone, 1 = Red/White Tactical Stop
    float stripePeriod;
    float dirtSplashWear;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float diag = fract((uv.x + uv.y) * max(pc.stripePeriod, 6.0));
    float stripeMask = smoothstep(0.46, 0.50, diag) - smoothstep(0.96, 1.00, diag);

    vec3 primaryCol = (pc.isRedWhiteStop != 0u) ? vec3(0.92, 0.11, 0.09) : vec3(0.98, 0.42, 0.04);
    vec3 whiteSheeting = vec3(0.95, 0.96, 0.95);
    vec3 albedo = mix(primaryCol, whiteSheeting, clamp(stripeMask, 0.0, 1.0));

    // Scuff & road mud splash on lower skirt
    float mud = (1.0 - smoothstep(0.0, 0.30, uv.y)) * roadFbm(uv * 16.0) * clamp(pc.dirtSplashWear, 0.0, 1.0);
    albedo = mix(albedo, vec3(0.28, 0.23, 0.17), mud * 0.75);

    float roughness = mix(0.20, 0.88, mud);
    float retroIntensity = mix(0.95, 0.12, mud);

    imageStore(outHazardAlbedo, px, vec4(albedo, 1.0));
    imageStore(outHazardMaterial, px, vec4(roughness, 0.04, retroIntensity, 1.0));
}
