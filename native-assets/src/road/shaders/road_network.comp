// ==============================================================================
// Road Network Graph - Topological Intersection Geometry Compute Shader
// Path: src/road/shaders/road_network.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "include/road_types.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer SegmentInputBuffer {
    vec4 segmentNodes[]; // xy0 = start XZ, zw = end XZ
};

layout(std430, set = 0, binding = 1) writeonly buffer NetworkVertexOut {
    RoadGpuVertex vertices[];
};

layout(push_constant) uniform NetworkComputePC {
    uint segmentCount;
    float roadWidthM;
    float cornerFilletRadiusM;
    float curbHeightM;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.segmentCount) {
        return;
    }

    vec4 seg = segmentNodes[idx];
    vec2 a = seg.xy;
    vec2 b = seg.zw;
    vec2 dir = normalize(b - a);
    vec2 right = vec2(dir.y, -dir.x);
    float halfW = pc.roadWidthM * 0.5;

    // Emit left/right asphalt carriage boundary pair per topological segment
    uint baseV = idx * 4u;
    vec3 nUp = vec3(0.0, 1.0, 0.0);
    vec4 colAsphalt = vec4(0.19, 0.21, 0.24, 1.0);

    vec2 p0L = a - right * halfW;
    vec2 p0R = a + right * halfW;
    vec2 p1L = b - right * halfW;
    vec2 p1R = b + right * halfW;

    vertices[baseV + 0u] = RoadGpuVertex(vec4(p0L.x, 0.32, p0L.y, 0.85), vec4(nUp, 0.02), vec4(0.0, 0.0, 1.0, 0.0), colAsphalt);
    vertices[baseV + 1u] = RoadGpuVertex(vec4(p0R.x, 0.32, p0R.y, 0.85), vec4(nUp, 0.02), vec4(1.0, 0.0, 1.0, 0.0), colAsphalt);
    vertices[baseV + 2u] = RoadGpuVertex(vec4(p1R.x, 0.32, p1R.y, 0.85), vec4(nUp, 0.02), vec4(1.0, 1.0, 1.0, 0.0), colAsphalt);
    vertices[baseV + 3u] = RoadGpuVertex(vec4(p1L.x, 0.32, p1L.y, 0.85), vec4(nUp, 0.02), vec4(0.0, 1.0, 1.0, 0.0), colAsphalt);
}
