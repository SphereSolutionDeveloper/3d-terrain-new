// ==============================================================================
// Road Spline Graph - Catmull-Rom & Superelevation Ribbon Compute Shader
// Path: src/road/shaders/road_spline.comp
// Evaluates theta_bank = atan(v^2 / (g * R)) and extrudes orthonormal ribbon
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "include/road_types.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer ControlPointsBuffer {
    RoadSplineControlPoint controlPoints[];
};

layout(std430, set = 0, binding = 1) writeonly buffer SplineVerticesOut {
    RoadGpuVertex outVertices[];
};

layout(push_constant) uniform SplineComputePC {
    uint sampleCount;
    uint controlPointCount;
    float defaultSpeedKmH;
    float camberCrownM;
} pc;

vec3 catmullRom(vec3 p0, vec3 p1, vec3 p2, vec3 p3, float t) {
    float t2 = t * t;
    float t3 = t2 * t;
    return 0.5 * (
        (2.0 * p1) +
        (-p0 + p2) * t +
        (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2 +
        (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * t3
    );
}

void main() {
    uint sliceIdx = gl_GlobalInvocationID.x;
    if (sliceIdx >= pc.sampleCount || pc.controlPointCount < 4u) {
        return;
    }

    float globalT = float(sliceIdx) / float(max(pc.sampleCount - 1u, 1u));
    float maxSeg = float(pc.controlPointCount - 3u);
    float scaled = clamp(globalT, 0.0, 1.0) * maxSeg;
    uint seg = min(uint(scaled), pc.controlPointCount - 4u);
    float lt = scaled - float(seg);

    vec3 p0 = controlPoints[seg + 0u].posAndWidth.xyz;
    vec3 p1 = controlPoints[seg + 1u].posAndWidth.xyz;
    vec3 p2 = controlPoints[seg + 2u].posAndWidth.xyz;
    vec3 p3 = controlPoints[seg + 3u].posAndWidth.xyz;

    float dt = 0.005;
    vec3 pos = catmullRom(p0, p1, p2, p3, lt);
    vec3 posPrev = catmullRom(p0, p1, p2, p3, max(0.0, lt - dt));
    vec3 posNext = catmullRom(p0, p1, p2, p3, min(1.0, lt + dt));

    vec3 T = normalize(posNext - posPrev);
    vec3 sideHoriz = normalize(vec3(T.z, 0.0, -T.x));

    float curvature = length(posNext - 2.0 * pos + posPrev) / max(dt * dt, 1e-4);
    float radiusM = (curvature > 1e-4) ? (1.0 / curvature) : 5000.0;
    float vMs = pc.defaultSpeedKmH / 3.6;
    float bankRad = clamp(atan((vMs * vMs) / (9.81 * max(radiusM, 18.0))) * 0.45, -0.18, 0.18);

    float cb = cos(bankRad);
    float sb = sin(bankRad);
    vec3 bankedSide = normalize(vec3(sideHoriz.x * cb, sb, sideHoriz.z * cb));
    vec3 bankedUp   = normalize(cross(bankedSide, T));

    float halfW = controlPoints[seg + 1u].posAndWidth.w * 0.5;
    vec3 leftPos  = pos - bankedSide * halfW;
    vec3 midPos   = pos + bankedUp * pc.camberCrownM;
    vec3 rightPos = pos + bankedSide * halfW;

    uint outBase = sliceIdx * 3u;
    vec4 asphaltColor = vec4(0.19, 0.21, 0.24, 1.0);
    outVertices[outBase + 0u] = RoadGpuVertex(vec4(leftPos,  0.84), vec4(bankedUp, 0.02), vec4(0.0, globalT, 1.0, 0.0), asphaltColor);
    outVertices[outBase + 1u] = RoadGpuVertex(vec4(midPos,   0.82), vec4(bankedUp, 0.02), vec4(0.5, globalT, 1.0, 0.0), asphaltColor);
    outVertices[outBase + 2u] = RoadGpuVertex(vec4(rightPos, 0.84), vec4(bankedUp, 0.02), vec4(1.0, globalT, 1.0, 0.0), asphaltColor);
}
