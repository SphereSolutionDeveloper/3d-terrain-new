// ==============================================================================
// Multi-State Road Surface Texture & PBR Normal/Roughness Generator (.comp)
// Path: src/road/shaders/road_surface_state_tex.comp
// States: 0=Dry, 1=Wet Puddles, 2=Muddy Ruts, 3=Gravel/Rocky, 4=Potholed, 5=Snowy/Icy
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outStateAlbedo;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outStateNormalRoughness;

layout(push_constant) uniform StateTexPC {
    uint texSize;
    uint surfaceState;     // 0..5
    float distressIntensity;
    float wetnessLevel;
} pc;

float sampleStateHeight(vec2 uv) {
    float base = roadFbm(uv * 22.0) * 0.35 + roadHash21(floor(uv * 220.0)) * 0.12;
    if (pc.surfaceState == 2u) {
        // Deep tire ruts + washboard ridges
        float rut = exp(-pow(abs(uv.x - 0.30), 2.0) * 45.0) + exp(-pow(abs(uv.x - 0.70), 2.0) * 45.0);
        base -= rut * 0.65 * pc.distressIntensity;
        base += sin(uv.y * 85.0) * 0.08 * pc.distressIntensity;
    } else if (pc.surfaceState == 4u) {
        // Voronoi alligator cracking + crater depression
        vec2 cid;
        float crackEdge = roadVoronoiEdgeDist(uv * 9.0, cid);
        float crater = 1.0 - smoothstep(0.06, 0.24, length(uv - vec2(0.35, 0.55)));
        base -= (1.0 - smoothstep(0.0, 0.06, crackEdge)) * 0.35;
        base -= crater * 0.75 * pc.distressIntensity;
    }
    return base;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float eps = 1.0 / float(max(pc.texSize, 1u));
    float hC = sampleStateHeight(uv);
    float hR = sampleStateHeight(uv + vec2(eps, 0.0));
    float hU = sampleStateHeight(uv + vec2(0.0, eps));
    vec3 normalTS = normalize(vec3((hC - hR) * 3.5, (hC - hU) * 3.5, 1.0));

    vec3 albedo = vec3(0.18, 0.20, 0.23);
    float roughness = 0.84;

    if (pc.surfaceState == 1u) {
        // Wet rain puddles along depressed tracks
        float puddle = smoothstep(0.45, 0.65, roadFbm(uv * 7.0) + pc.wetnessLevel * 0.28);
        albedo = mix(vec3(0.16, 0.18, 0.21), vec3(0.09, 0.12, 0.16), puddle);
        roughness = mix(0.68, 0.08, puddle);
        normalTS = mix(normalTS, vec3(0.0, 0.0, 1.0), puddle * 0.92);
    } else if (pc.surfaceState == 2u) {
        // Muddy ruts
        float f = roadFbm(uv * 12.0);
        albedo = mix(vec3(0.28, 0.20, 0.13), vec3(0.46, 0.34, 0.22), f);
        roughness = mix(0.32, 0.92, f);
    } else if (pc.surfaceState == 3u) {
        // Crushed basalt gravel aggregate
        vec2 cid;
        float stone = roadVoronoiEdgeDist(uv * 28.0, cid);
        float tint = 0.34 + 0.22 * roadHash21(cid);
        albedo = vec3(tint, tint * 0.96, tint * 0.88) * (0.7 + 0.3 * smoothstep(0.0, 0.15, stone));
        roughness = 0.90;
    } else if (pc.surfaceState == 4u) {
        // Potholed & alligator-cracked asphalt
        float crater = 1.0 - smoothstep(0.08, 0.24, length(uv - vec2(0.35, 0.55)));
        albedo = mix(vec3(0.22, 0.23, 0.25), vec3(0.38, 0.35, 0.30), crater);
        roughness = mix(0.86, 0.95, crater);
    } else if (pc.surfaceState == 5u) {
        // Packed snow & exposed glazed ice tire tracks
        float trackDist = min(abs(uv.x - 0.30), abs(uv.x - 0.70));
        float iceMask = 1.0 - smoothstep(0.05, 0.12, trackDist);
        albedo = mix(vec3(0.90, 0.94, 0.98), vec3(0.35, 0.48, 0.60), iceMask);
        roughness = mix(0.76, 0.10, iceMask);
    }

    imageStore(outStateAlbedo, px, vec4(albedo, 1.0));
    imageStore(outStateNormalRoughness, px, vec4(normalTS * 0.5 + 0.5, roughness));
}
