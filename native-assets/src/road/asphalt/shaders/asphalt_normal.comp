// ==============================================================================
// Procedural Asphalt Tangent-Space Normal Map Compute Kernel (.comp)
// Path: src/road/asphalt/shaders/asphalt_normal.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outAsphaltNormal;

layout(push_constant) uniform AsphaltNormalPC {
    uint texSize;
    float aggregateScale;
    float normalStrength;
    float crackSeverity;
} pc;

float evalHeight(vec2 uv) {
    vec2 cid;
    float edge = roadVoronoiEdgeDist(uv * max(pc.aggregateScale, 28.0), cid);
    float chip = smoothstep(0.02, 0.25, edge) * (0.5 + 0.5 * roadHash21(cid));
    float macro = roadFbm(uv * 14.0) * 0.35;
    vec2 crackCid;
    float crack = (1.0 - smoothstep(0.0, 0.045, roadVoronoiEdgeDist(uv * 6.5, crackCid))) * clamp(pc.crackSeverity, 0.0, 1.0);
    return chip * 0.65 + macro - crack * 0.85;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    float denom = float(max(pc.texSize - 1u, 1u));
    vec2 uv = vec2(px) / denom;
    float eps = 1.0 / denom;

    float hL = evalHeight(uv - vec2(eps, 0.0));
    float hR = evalHeight(uv + vec2(eps, 0.0));
    float hD = evalHeight(uv - vec2(0.0, eps));
    float hU = evalHeight(uv + vec2(0.0, eps));

    float strength = max(pc.normalStrength, 1.0);
    vec3 normalTS = normalize(vec3((hL - hR) * strength, (hD - hU) * strength, 1.0));
    imageStore(outAsphaltNormal, px, vec4(normalTS * 0.5 + 0.5, 1.0));
}
