// ==============================================================================
// Procedural Asphalt Albedo & Bitumen Aggregate Compute Kernel (.comp)
// Path: src/road/asphalt/shaders/asphalt_albedo.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outAsphaltAlbedo;

layout(push_constant) uniform AsphaltAlbedoPC {
    uint texSize;
    float aggregateScale;
    float bitumenWear;
    float laneTireTrackIntensity;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float aggScale = max(pc.aggregateScale, 28.0);

    vec2 cid;
    float stoneEdge = roadVoronoiEdgeDist(uv * aggScale, cid);
    float chipId = roadHash21(cid);
    float microNoise = roadFbm(uv * 18.0);

    // Crushed basalt & granite chip matrix embedded in oxidized bitumen
    vec3 bitumenBase = mix(vec3(0.085, 0.092, 0.105), vec3(0.20, 0.21, 0.23), clamp(pc.bitumenWear, 0.0, 1.0));
    vec3 chipTint = mix(vec3(0.22, 0.23, 0.25), vec3(0.38, 0.37, 0.34), chipId);
    float chipMask = smoothstep(0.06, 0.22, stoneEdge);

    vec3 albedo = mix(bitumenBase, chipTint, chipMask * 0.55) * (0.85 + 0.30 * microNoise);

    // Dual wheel-track polishing in lane thirds
    float trackDist = min(abs(uv.x - 0.30), abs(uv.x - 0.70));
    float wheelTrack = (1.0 - smoothstep(0.04, 0.14, trackDist)) * clamp(pc.laneTireTrackIntensity, 0.0, 1.0);
    albedo = mix(albedo, albedo * 0.78 + vec3(0.04), wheelTrack * 0.65);

    imageStore(outAsphaltAlbedo, px, vec4(albedo, 1.0));
}
