// ==============================================================================
// Procedural Asphalt ORM (Occlusion / Roughness / Metallic) Texture Kernel (.comp)
// Path: src/road/asphalt/shaders/asphalt_orm.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outAsphaltOrm;

layout(push_constant) uniform AsphaltOrmPC {
    uint texSize;
    float aggregateScale;
    float bitumenWetness;
    float laneTireTrackIntensity;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    vec2 cid;
    float edge = roadVoronoiEdgeDist(uv * max(pc.aggregateScale, 28.0), cid);
    float microAo = mix(0.62, 1.0, smoothstep(0.02, 0.24, edge));

    float trackDist = min(abs(uv.x - 0.30), abs(uv.x - 0.70));
    float wheelTrack = (1.0 - smoothstep(0.04, 0.14, trackDist)) * clamp(pc.laneTireTrackIntensity, 0.0, 1.0);

    float puddle = smoothstep(0.45, 0.68, roadFbm(uv * 7.0) + clamp(pc.bitumenWetness, 0.0, 1.0) * 0.35) * clamp(pc.bitumenWetness, 0.0, 1.0);
    float roughness = clamp(mix(0.88 - wheelTrack * 0.22, 0.10, puddle), 0.08, 0.96);
    float metallic = 0.02;

    imageStore(outAsphaltOrm, px, vec4(microAo, roughness, metallic, 1.0));
}
