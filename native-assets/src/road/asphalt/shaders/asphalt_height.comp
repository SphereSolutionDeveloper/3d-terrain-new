// ==============================================================================
// Procedural Asphalt Micro-Texture Heightfield Compute Kernel (.comp)
// Path: src/road/asphalt/shaders/asphalt_height.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r16f) uniform writeonly image2D outAsphaltHeight;

layout(push_constant) uniform AsphaltHeightPC {
    uint texSize;
    float aggregateScale;
    float macroTextureDepth;
    float crackSeverity;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    float aggScale = max(pc.aggregateScale, 28.0);

    vec2 cid;
    float stoneEdge = roadVoronoiEdgeDist(uv * aggScale, cid);
    float stoneElev = smoothstep(0.02, 0.25, stoneEdge) * (0.45 + 0.55 * roadHash21(cid + vec2(3.1, 7.4)));
    float macroNoise = roadFbm(uv * 12.0);

    // Longitudinal micro-cracking & tire depression
    vec2 crackCid;
    float crackEdge = roadVoronoiEdgeDist(uv * 6.5, crackCid);
    float crackCut = (1.0 - smoothstep(0.0, 0.045, crackEdge)) * clamp(pc.crackSeverity, 0.0, 1.0);

    float h = clamp((stoneElev * 0.65 + macroNoise * 0.35) * max(pc.macroTextureDepth, 0.2) - crackCut * 0.85, 0.0, 1.0);
    imageStore(outAsphaltHeight, px, vec4(h, 0.0, 0.0, 1.0));
}
