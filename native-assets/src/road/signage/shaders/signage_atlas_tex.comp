// ==============================================================================
// Procedural MUTCD Highway Sign Face & Border Atlas Kernel (.comp)
// Path: src/road/signage/shaders/signage_atlas_tex.comp
// ==============================================================================
#version 460
#extension GL_ARB_separate_shader_objects : enable

#include "../../shaders/include/road_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outSignAlbedo;

layout(push_constant) uniform SignageAtlasPC {
    uint texSize;
    uint boardScheme; // 0 = Guide Green, 1 = Warning Yellow, 2 = Regulatory White/Red
    float borderThickness;
    float textBandDensity;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.texSize) || px.y >= int(pc.texSize)) {
        return;
    }

    vec2 uv = vec2(px) / float(max(pc.texSize - 1u, 1u));
    vec3 bg = vec3(0.03, 0.38, 0.19);
    vec3 fg = vec3(0.95, 0.96, 0.94);

    if (pc.boardScheme == 1u) {
        bg = vec3(0.98, 0.72, 0.04);
        fg = vec3(0.08, 0.08, 0.09);
    } else if (pc.boardScheme == 2u) {
        bg = vec3(0.95, 0.96, 0.94);
        fg = vec3(0.84, 0.12, 0.10);
    }

    float dEdge = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
    float inset = clamp(pc.borderThickness, 0.02, 0.08);
    float border = (1.0 - smoothstep(0.008, 0.015, abs(dEdge - inset)));

    // Synthetic route shield & directional legend glyph rows
    float rowBand = step(0.35, fract(uv.y * max(pc.textBandDensity, 4.0)));
    float colMask = step(0.14, uv.x) * step(uv.x, 0.86) * step(0.20, uv.y) * step(uv.y, 0.82);
    float glyphNoise = step(0.45, roadValueNoise(uv * vec2(26.0, 12.0)));
    float legend = rowBand * colMask * glyphNoise * 0.92;

    // Microprismatic diamond honeycomb shimmer
    float diamond = 0.94 + 0.06 * step(0.5, fract((uv.x + uv.y) * 32.0));
    vec3 finalCol = mix(bg * diamond, fg, clamp(max(border, legend), 0.0, 1.0));

    imageStore(outSignAlbedo, px, vec4(finalCol, 1.0));
}
